@model IEnumerable<DoAn.Models.ThongTinNH>
@{
    ViewBag.Title = "Thanh Toán QR";
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
}

<style>
    .qr-glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border-radius: 30px;
        padding: 40px;
        max-width: 550px;
        margin: auto;
        box-shadow: 0 10px 50px rgba(236, 72, 153, 0.15);
        border: 1px solid white;
    }

    .timer-badge {
        background: #fff0f5;
        color: #ec4899;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: bold;
        display: inline-block;
        margin-bottom: 20px;
        border: 1px solid #ec4899;
    }

    .qr-frame {
        background: white;
        padding: 15px;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        display: inline-block;
        margin-bottom: 25px;
    }
</style>

<div class="container my-5 text-center">
    <div class="qr-glass-card">
        <h2 class="fw-bold mb-3">Quét Mã QR</h2>

        <div id="payment-timer" class="timer-badge">
            <i class="fas fa-clock me-2"></i>Hiệu lực: 10:00
        </div>

        <div id="expired-message" style="display:none;" class="alert alert-danger rounded-pill">
            <i class="fas fa-exclamation-circle me-1"></i> Mã QR đã hết hạn!
        </div>

        <div class="qr-frame">
            <img src="@ViewBag.QRImageUrl" alt="QR Code" id="qr-image" class="img-fluid" style="width: 280px; height: 280px;" />
        </div>

        <div id="payment-details" class="bg-white bg-opacity-50 rounded-3 p-3 mb-4 text-start">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Ngân hàng:</span>
                <span class="fw-bold">@ViewBag.BankName</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Số tiền:</span>
                <span class="fw-bold text-pink">@(((decimal)ViewBag.Amount).ToString("N0")) ₫</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Nội dung CK:</span>
                <span class="fw-bold text-primary">@ViewBag.Memo</span>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a href="@Url.Action("XacNhanDaThanhToanQR", "DatHang", new { maHD = ViewBag.MaHD })"
               class="btn btn-primary text-white fw-bold py-3 rounded-pill"
               style="background: linear-gradient(45deg, #ec4899, #ff8a80); border:none;"
               id="btn-paid">
                <i class="fas fa-check-circle me-2"></i> Tôi đã thanh toán
            </a>

            <a href="@Url.Action("HuyThanhToan", "DatHang", new { maHD = ViewBag.MaHD })"
               class="btn btn-light text-secondary fw-bold py-3 rounded-pill"
               id="btn-cancel">
                Hủy thanh toán
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var duration = 600; // 10 phút
            var timerElement = document.getElementById('payment-timer');
            var expiredMessage = document.getElementById('expired-message');
            var qrImage = document.getElementById('qr-image');
            var btnPaid = document.getElementById('btn-paid');
            var btnCancel = document.getElementById('btn-cancel');

            var timerInterval = setInterval(function () {
                var minutes = Math.floor(duration / 60);
                var seconds = duration % 60;
                seconds = seconds < 10 ? "0" + seconds : seconds;
                timerElement.innerHTML = "<i class='fas fa-clock me-2'></i>Hiệu lực: " + minutes + ":" + seconds;
                duration--;

                if (duration < 0) {
                    clearInterval(timerInterval);
                    timerElement.style.display = 'none';
                    qrImage.style.opacity = '0.2'; // Làm mờ QR thay vì ẩn hẳn
                    btnPaid.classList.add('disabled');
                    expiredMessage.style.display = 'block';
                    btnCancel.innerHTML = '<i class="fas fa-arrow-left"></i> Quay lại';
                    btnCancel.classList.remove('btn-light');
                    btnCancel.classList.add('btn-outline-danger');
                }
            }, 1000);
        });
    </script>
}