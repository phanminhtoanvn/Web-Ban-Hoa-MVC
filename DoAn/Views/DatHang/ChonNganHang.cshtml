@model IEnumerable<DoAn.Models.ThongTinNH>
@{
    ViewBag.Title = "Chọn Ngân Hàng";
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
    string amountFormatted = ((decimal)ViewBag.TongTien).ToString("N0");
}

<style>
    /* CSS Grid cho Bank Logo */
    .glass-box {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        max-width: 700px;
        margin: auto;
    }

    .bank-card {
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 2px solid rgba(0,0,0,0.05);
        border-radius: 15px;
        padding: 15px;
        transition: all 0.3s;
        height: 100px; /* Chiều cao cố định */
        position: relative;
        overflow: hidden;
    }

        .bank-card img {
            max-width: 80%;
            max-height: 60px;
            object-fit: contain;
        }

        .bank-card:hover {
            border-color: #ec4899;
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(236, 72, 153, 0.2);
        }
</style>

<div class="container my-5">
    <div class="glass-box text-center">
        <h2 class="fw-bold mb-3">Chọn Ngân Hàng</h2>
        <p class="text-muted mb-4">
            Chọn ngân hàng bạn muốn sử dụng để thanh toán số tiền
            <span class="text-pink fw-bold fs-5">@amountFormatted ₫</span>
        </p>

        <div class="row g-3 justify-content-center">
            @foreach (var bank in (List<DoAn.Models.ThongTinNH>)ViewBag.BankList)
            {
                <div class="col-6 col-md-4">
                    <a href="@Url.Action("ThanhToanQR", "DatHang", new { maHD = ViewBag.MaHD, bankId = bank.Id, bankName = bank.Name })"
                       class="bank-card text-decoration-none"
                       title="Thanh toán qua @bank.Name">
                        <img src="@bank.LogoUrl" alt="@bank.Name" />
                    </a>
                </div>
            }
        </div>

        <div class="mt-5">
            <a href="@Url.Action("ThanhToan", "DatHang")" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
        </div>
    </div>
</div>