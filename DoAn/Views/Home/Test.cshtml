
@{
    ViewBag.Title = "Test";
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Content -->
            <div class="col-lg-6">
                <div class="hero-badge">
                    ✨ Giảm giá đến 30% cho đơn hàng đầu tiên
                </div>

                <h1 class="hero-title">
                    Gửi tình yêu <br />
                    qua từng <span class="highlight">đóa hoa</span>
                </h1>

                <p class="lead text-muted mb-4">
                    Hoa tươi mỗi ngày - Giao hàng nhanh chóng - Thiết kế độc đáo
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="@Url.Action("Products", "Shop")" class="btn btn-primary-custom btn-lg">
                        Xem sản phẩm
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                    <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-custom btn-lg">
                        Liên hệ tư vấn
                    </a>
                </div>

                <!-- Stats -->
                <div class="hero-stats">
                    <div class="stat-item">
                        <div class="stat-number">500+</div>
                        <div class="stat-label">Mẫu hoa</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">10K+</div>
                        <div class="stat-label">Khách hàng</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">4.9★</div>
                        <div class="stat-label">Đánh giá</div>
                    </div>
                </div>
            </div>

            <!-- Right Image -->
            <div class="col-lg-6">
                <div class="hero-image position-relative">
                    <img src="https://images.unsplash.com/photo-1589244159943-460088ed5c92?w=800" alt="Flower Shop" />

                    <!-- Floating Card -->
                    <div class="floating-card">
                        <div class="floating-icon">🎁</div>
                        <div>
                            <div class="fw-semibold">Quà tặng miễn phí</div>
                            <div class="small text-muted">Cho đơn từ 500K</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

