@model IEnumerable<DoAn.Models.CamNangHoaMongo>
@{
    ViewBag.Title = "Cẩm nang hoa & Tin tức";
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-pink"><i class="fas fa-book-open me-2"></i>Cẩm nang hoa</h2>
        <a href="@Url.Action("TaoMoi", "TinTuc")" class="btn btn-primary rounded-pill px-4" style="background-color: #ec4899; border:none;">
            <i class="fas fa-plus me-2"></i>Viết bài mới
        </a>
    </div>

    <!-- Thanh tìm kiếm & Lọc -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 p-3 bg-light">
        <form action="@Url.Action("Index", "TinTuc")" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="tuKhoa" class="form-control rounded-pill" placeholder="Tìm kiếm theo tiêu đề..." value="@ViewBag.TuKhoa" />
            </div>
            <div class="col-md-4">
                <input type="text" name="tagFilter" class="form-control rounded-pill" placeholder="Lọc theo Tag (VD: HoaHong)" value="@ViewBag.TagFilter" />
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-dark rounded-pill w-100">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <!-- Danh sách bài viết -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                <a href="@Url.Action("ChiTiet", "TinTuc", new { id = item.Id })" class="text-decoration-none text-dark">
                                    @item.TieuDe
                                </a>
                            </h5>
                            <div class="text-muted small mb-3">
                                <span><i class="fas fa-user-edit me-1"></i>@item.TacGia</span> |
                                <span><i class="far fa-calendar-alt me-1"></i>@item.NgayDang.ToString("dd/MM/yyyy")</span> |
                                <span><i class="far fa-eye me-1"></i>@item.LuotXem</span>
                            </div>

                            <div class="mb-3">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="badge bg-secondary rounded-pill me-1 fw-normal">#@tag</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                            <a href="@Url.Action("Sua", "TinTuc", new { id = item.Id })" class="btn btn-sm btn-outline-primary rounded-pill">Sửa</a>
                            <a href="@Url.Action("Xoa", "TinTuc", new { id = item.Id })" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này?');">Xóa</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="fas fa-search fa-3x mb-3 opacity-50"></i>
                <p>Không tìm thấy bài viết nào.</p>
            </div>
        }
    </div>
</div>