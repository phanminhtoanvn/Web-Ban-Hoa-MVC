@model DoAn.Models.CamNangHoaMongo
@{
    ViewBag.Title = "Viết bài mới";
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h3 class="fw-bold text-pink">Viết bài mới</h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("TaoMoi", "TinTuc", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TieuDe, new { @class = "form-control rounded-3", required = "required", placeholder = "Nhập tiêu đề..." })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tác giả</label>
                            @Html.TextBoxFor(m => m.TacGia, new { @class = "form-control rounded-3", placeholder = "Tên người viết" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nội dung bài viết <span class="text-danger">*</span></label>
                            <!-- Chú ý: Ở dự án thực tế, bạn có thể nhúng thư viện CKEditor hoặc TinyMCE vào textarea này -->
                            @Html.TextAreaFor(m => m.NoiDung_HTML, new { @class = "form-control rounded-3", required = "required", rows = "10", placeholder = "Viết nội dung (Hỗ trợ thẻ HTML)..." })
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Danh sách Tags (Từ khóa)</label>
                            @Html.TextBoxFor(m => m.TagsInput, new { @class = "form-control rounded-3", placeholder = "Mỗi thẻ cách nhau bằng dấu phẩy. VD: HoaHong, SuKien" })
                            <small class="text-muted">Giúp người dùng dễ dàng lọc và tìm kiếm bài viết.</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "TinTuc")" class="btn btn-light rounded-pill px-4 border">Quay lại</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5" style="background-color: #ec4899; border:none;">
                                Đăng bài
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>