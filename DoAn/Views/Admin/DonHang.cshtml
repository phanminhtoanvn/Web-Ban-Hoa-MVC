@model List<DoAn.tblHoaDon>
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var tinhTrangList = ViewBag.TinhTrangList as List<DoAn.tblTinhTrang>;
}

<h2 class="mb-4 fw-bold text-dark">@ViewBag.Title</h2>

<div class="admin-glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã HĐ</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái (Cập nhật)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-pink">#@item.MaHD</td>
                        <td>
                            <div class="fw-semibold">@item.tblKhachHang.TenKH</div>
                            <small class="text-muted">@item.tblKhachHang.DienThoai</small>
                        </td>
                        <td>@string.Format("{0:dd/MM/yyyy HH:mm}", item.NgayLap)</td>
                        <td class="fw-bold">@string.Format("{0:#,##0} ₫", item.TongTien)</td>
                        <td>
                            @if (item.DaThanhToan == true)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill">
                                    <i class="fas fa-check me-1"></i>Đã thanh toán
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1 rounded-pill">
                                    <i class="fas fa-clock me-1"></i>Chờ thanh toán
                                </span>
                            }
                        </td>
                        <td>
                            @using (Html.BeginForm("CapNhatTrangThai", "Admin", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaHD_Update" value="@item.MaHD" />
                                <div class="d-flex gap-2">
                                    <select class="form-select form-select-sm rounded-pill" name="TinhTrang_Update"
                                            style="width: 140px; border-color: #ec4899;">
                                        @foreach (var status in tinhTrangList)
                                        {
                                            <option value="@status.ID" @(item.TinhTrang == status.ID ? "selected" : "")>
                                                @status.TinhTrangHoaDon
                                            </option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary rounded-circle" title="Lưu trạng thái">
                                        <i class="fas fa-save"></i>
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>