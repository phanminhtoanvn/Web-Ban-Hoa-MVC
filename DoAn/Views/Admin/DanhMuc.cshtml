@model List<DoAn.tblDanhMucHoa>
@{
    ViewBag.Title = "Quản lý Danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 fw-bold text-dark">@ViewBag.Title</h2>
    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="fas fa-plus me-2"></i> Thêm danh mục
    </button>
</div>

<div class="admin-glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã DM</th>
                    <th>Tên Danh mục</th>
                    <th>Ghi chú</th>
                    <th class="text-end" style="width: 150px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaDM</td>
                        <td class="fw-bold text-primary">@item.TenDM</td>
                        <td class="text-muted">@item.GhiChu</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary border-0 rounded-circle"
                                    data-bs-toggle="modal" data-bs-target="#editModal"
                                    data-madm="@item.MaDM" data-tendm="@item.TenDM" data-ghichu="@item.GhiChu">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger border-0 rounded-circle"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-madm="@item.MaDM" data-tendm="@item.TenDM">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-pink">Thêm Danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("ThemDanhMuc", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên danh mục</label>
                        <input type="text" class="form-control rounded-3" name="TenDM_Add" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Ghi chú</label>
                        <textarea class="form-control rounded-3" name="GhiChu_Add"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-primary">Sửa Danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("SuaDanhMuc", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="MaDM_Edit" id="edit-madm" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên danh mục</label>
                        <input type="text" class="form-control rounded-3" name="TenDM_Edit" id="edit-tendm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Ghi chú</label>
                        <textarea class="form-control rounded-3" name="GhiChu_Edit" id="edit-ghichu"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-danger">Xóa Danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("XoaDanhMuc", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body text-center">
                    <input type="hidden" name="MaDM_Delete" id="delete-madm" />
                    <p>Bạn có chắc muốn xóa <strong id="delete-tendm"></strong>?</p>
                </div>
                <div class="modal-footer border-top-0 justify-content-center">
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Xóa</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var editModal = document.getElementById('editModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            editModal.querySelector('#edit-madm').value = button.getAttribute('data-madm');
            editModal.querySelector('#edit-tendm').value = button.getAttribute('data-tendm');
            editModal.querySelector('#edit-ghichu').value = button.getAttribute('data-ghichu');
        });

        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            deleteModal.querySelector('#delete-madm').value = button.getAttribute('data-madm');
            deleteModal.querySelector('#delete-tendm').innerText = button.getAttribute('data-tendm');
        });
    });
</script>