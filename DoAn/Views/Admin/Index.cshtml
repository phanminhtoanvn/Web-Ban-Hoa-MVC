@{
    ViewBag.Title = "Tổng quan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool isAdmin = ViewBag.IsAdmin ?? false; // Lấy cờ từ Controller
}

<style>
    /* --- ADMIN DASHBOARD GLASS STYLE --- */

    /* 1. Card thống kê */
    .stat-glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.05);
        transition: transform 0.3s;
        height: 100%;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .stat-glass-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.9);
        }

    /* Icon tròn */
    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 20px;
        flex-shrink: 0;
    }

    /* Màu sắc riêng cho từng loại */
    .bg-gradient-pink {
        background: linear-gradient(135deg, #ec4899 0%, #ff8a80 100%);
        color: white;
    }

    .bg-gradient-blue {
        background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
        color: white;
    }

    .bg-gradient-green {
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        color: white;
    }

    .bg-gradient-orange {
        background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
        color: white;
    }

    /* Số liệu to */
    .stat-value {
        font-size: 1.8rem;
        font-weight: 800;
        color: #444;
    }

    .stat-label {
        color: #666;
        font-size: 0.95rem;
        font-weight: 500;
    }

    /* 2. Khung biểu đồ */
    .chart-glass-box {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(15px);
        border-radius: 25px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.5);
        margin-top: 30px;
        box-shadow: 0 10px 40px rgba(236, 72, 153, 0.05);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Dashboard</h2>
        <p class="text-secondary mb-0">
            Xin chào,
            <span class="text-pink fw-bold">@Session["TenNV"]</span>
            @(isAdmin ? "(Quản trị viên)" : "(Nhân viên)")
        </p>
    </div>
    <div class="date-badge px-3 py-2 rounded-pill bg-white shadow-sm text-muted small">
        <i class="far fa-calendar-alt me-2"></i> @DateTime.Now.ToString("dd/MM/yyyy")
    </div>
</div>

<div class="row g-4">

    <div class="col-md-4">
        <div class="stat-glass-card">
            <div class="stat-icon bg-gradient-orange">
                <i class="fas fa-bell"></i>
            </div>
            <div>
                <div class="stat-value text-warning">@ViewBag.SoDonHangMoi</div>
                <div class="stat-label">Đơn hàng mới chờ xử lý</div>
            </div>
            <a href="@Url.Action("DonHang", "Admin")" class="stretched-link"></a>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="col-md-4">
            <div class="stat-glass-card">
                <div class="stat-icon bg-gradient-green">
                    <i class="fas fa-wallet"></i>
                </div>
                <div>
                    <div class="stat-value text-success">@ViewBag.TongDoanhThu.ToString("N0") ₫</div>
                    <div class="stat-label">Tổng doanh thu (Thực nhận)</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-glass-card">
                <div class="stat-icon bg-gradient-blue">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="stat-value text-primary">@ViewBag.SoKhachHang</div>
                    <div class="stat-label">Tổng số khách hàng</div>
                </div>
            </div>
        </div>
    }
    else
    {
        /* --- GIAO DIỆN RIÊNG CHO NHÂN VIÊN (Lấp khoảng trống) --- */
        <div class="col-md-8">
            <div class="stat-glass-card bg-white">
                <div class="p-2">
                    <h5 class="fw-bold text-pink"><i class="fas fa-heart me-2"></i>Chúc bạn một ngày làm việc vui vẻ!</h5>
                    <p class="text-muted mb-0">Hãy kiểm tra và xử lý các đơn hàng mới nhanh chóng để khách hàng hài lòng nhé.</p>
                </div>
            </div>
        </div>
    }
</div>

@if (isAdmin)
{
    <div class="chart-glass-box">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <div class="d-flex align-items-center">
                <h5 class="fw-bold mb-0 text-dark me-3">
                    <i class="fas fa-chart-line me-2 text-pink"></i>@ViewBag.ChartTitle
                </h5>
                
            </div>

            <form method="get" action="@Url.Action("Index", "Admin")" class="d-flex gap-2 align-items-center">
                <select name="month" class="form-select form-select-sm rounded-pill border-pink text-pink" style="width: 130px; background-color: rgba(255,255,255,0.5);">
                    <option value="">-- Cả năm --</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" @(ViewBag.SelectedMonth == i ? "selected" : "")>Tháng @i</option>
                    }
                </select>

                <select name="year" class="form-select form-select-sm rounded-pill border-pink text-pink fw-bold" style="width: 100px; background-color: rgba(255,255,255,0.5);">
                    @foreach (var y in ViewBag.YearList)
                    {
                        <option value="@y" @(ViewBag.SelectedYear == y ? "selected" : "")>@y</option>
                    }
                </select>

                <button type="submit" class="btn btn-sm btn-pink rounded-circle shadow-sm text-white" style="background: #ec4899; width: 32px; height: 32px;">
                    <i class="fas fa-filter"></i>
                </button>
            </form>
        </div>

        <div style="position: relative; height: 350px; width: 100%;">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
}

@section Scripts {
    @if (isAdmin)
    {

        string rawLabels = Convert.ToString(ViewBag.ChartLabels);
        string rawData = Convert.ToString(ViewBag.ChartData);


        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
        document.addEventListener("DOMContentLoaded", function () {

            // BƯỚC 2: Nhận dữ liệu từ biến đã khai báo ở trên
            

            var dataStr = "@rawData";
            var chartData = [];

            if (dataStr.trim() !== "") {
                chartData = dataStr.split(',').map(Number);
            }

            // Dùng Html.Raw với biến string cụ thể -> Hết lỗi delegate
            var labels = [@Html.Raw(rawLabels)];

            // Vẽ biểu đồ
            var ctx = document.getElementById('revenueChart').getContext('2d');
            var revenueChart = new Chart(ctx, {
                type: 'bar', // Dạng cột
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: chartData,
                        backgroundColor: 'rgba(236, 72, 153, 0.6)', // Màu hồng kính
                        borderColor: '#ec4899',
                        borderWidth: 1,
                        borderRadius: 5,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    // Format tiền tệ khi hover vào cột
                                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    // Format trục Y thành tiền Việt (ví dụ: 1.000.000 ₫)
                                    return value.toLocaleString('vi-VN') + ' ₫';
                                }
                            }
                        }
                    }
                }
            });
        });
        </script>
    }
}