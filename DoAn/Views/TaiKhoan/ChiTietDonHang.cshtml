@model tblHoaDon
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaHD;
    Layout = "~/Views/Shared/_LayoutBanHoa.cshtml";
}

<style>
    .invoice-glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid white;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(236, 72, 153, 0.1);
        max-width: 800px;
        margin: 40px auto;
    }

    .invoice-header {
        border-bottom: 2px dashed rgba(0,0,0,0.1);
        padding-bottom: 20px;
        margin-bottom: 20px;
    }

    .invoice-footer {
        border-top: 2px dashed rgba(0,0,0,0.1);
        padding-top: 20px;
        margin-top: 20px;
    }

    .step-progress {
        display: flex;
        justify-content: space-between;
        margin: 30px 0;
        position: relative;
    }

    .step-item {
        z-index: 1;
        text-align: center;
        width: 33.33%;
        opacity: 0.5;
    }

        .step-item.active {
            opacity: 1;
            color: #ec4899;
            font-weight: bold;
        }

        .step-item i {
            font-size: 1.5rem;
            margin-bottom: 10px;
            display: block;
        }
</style>

<div class="container">
    <div class="invoice-glass-card">

        <div class="invoice-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1">Đơn hàng #@Model.MaHD</h4>
                <span class="text-muted small">Ngày đặt: @string.Format("{0:dd/MM/yyyy HH:mm}", Model.NgayLap)</span>
            </div>
            <div class="text-end">
                @if (Model.DaThanhToan == true)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                        <i class="fas fa-check-circle me-1"></i> ĐÃ THANH TOÁN
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2 rounded-pill">
                        <i class="fas fa-clock me-1"></i> CHƯA THANH TOÁN
                    </span>
                }
            </div>
        </div>

        <div class="step-progress">
            <div class="step-item @(Model.TinhTrang >= 1 ? "active" : "")">
                <i class="fas fa-clipboard-check"></i> Đã đặt
            </div>
            <div class="step-item @(Model.TinhTrang >= 2 ? "active" : "")">
                <i class="fas fa-shipping-fast"></i> Đang giao
            </div>
            <div class="step-item @(Model.TinhTrang >= 3 ? "active" : "")">
                <i class="fas fa-box-open"></i> Hoàn tất
            </div>
        </div>

        <div class="row mb-4 p-3 bg-white bg-opacity-50 rounded-3 mx-0">
            <div class="col-md-6">
                <h6 class="fw-bold text-pink">Thông tin người nhận</h6>
                <p class="mb-1"><strong>Tên:</strong> @Model.tblKhachHang.TenKH</p>
                <p class="mb-1"><strong>SĐT:</strong> @Model.tblKhachHang.DienThoai</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold text-pink">Địa chỉ giao hàng</h6>
                <p class="mb-0">@Model.DiaChiGiaoHang</p>
            </div>
        </div>

        <h6 class="fw-bold mb-3">Sản phẩm đã mua</h6>
        <table class="table table-borderless">
            <tbody>
                @foreach (var item in Model.tblChiTietHoaDon)
                {
                    <tr class="border-bottom border-light">
                        <td style="width: 60px;">
                            <img src="~/Content/HinhAnh/@item.tblHoa.AnhDaiDien" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.tblHoa.TenHoa</div>
                            <small class="text-muted">@string.Format("{0:#,##0}", item.GiaBan) ₫ x @item.SoLuong</small>
                        </td>
                        <td class="text-end fw-bold align-middle">
                            @string.Format("{0:#,##0}", item.GiaBan * item.SoLuong) ₫
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="invoice-footer d-flex justify-content-between align-items-center">
            <a href="@Url.Action("ThongTin", "TaiKhoan")" class="btn btn-outline-secondary rounded-pill btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
            <div class="text-end">
                <span class="text-muted me-2">Tổng cộng:</span>
                <span class="h4 fw-bold text-pink mb-0">@string.Format("{0:#,##0}", Model.TongTien) ₫</span>
            </div>
        </div>

    </div>
</div>