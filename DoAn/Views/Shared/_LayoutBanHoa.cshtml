
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - FlowerShop</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/FlowerShop.css" rel="stylesheet" />
    <link href="~/Content/fontawesome-free-7.1.0-web/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    
                    <i class="fas fa-phone"></i>
                    <span>Hotline: 1900-1234</span>
                </div>
                <div class="d-none d-md-block">
                    Miễn phí giao hàng nội thành | Giao hàng toàn quốc 
                </div>
            </div>
        </div>
    </div>

    <header class="main-header">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between py-3">

                <a href="@Url.Action("Index", "Hoa")" class="logo-wrapper">
                    <div class="logo-icon">🌸</div>
                    <span class="logo-text">FlowerShop</span>
                </a>

                <form class="search-box input-group mx-3" action="/Hoa/Index" method="get" style="max-width: 400px; flex-grow: 1;">
                    <input type="text" name="q" class="form-control" placeholder="Tìm kiếm hoa, bó hoa..." />
                    <button class="btn btn-outline-pink" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </form>


                <div class="d-flex align-items-center gap-3">

                    @if (Session["UserType"] != null)
                    {
                        // --- AI ĐÓ ĐÃ ĐĂNG NHẬP ---
                        if (Session["UserType"].ToString() == "Customer")
                        {
                            // --- TRƯỜNG HỢP LÀ KHÁCH HÀNG ---
                            <div class="navbar-nav d-flex align-items-center" style="flex-direction: row; gap: 10px;">
                                <a href="@Url.Action("ThongTin", "TaiKhoan")" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-user-circle me-1"></i> @Session["TenKH"]
                                </a>

                                <a href="@Url.Action("DangXuat", "TaiKhoan")" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
                            </div>
                        }
                        else if (Session["UserType"].ToString() == "Admin")
                        {
                            // --- TRƯỜNG HỢP LÀ ADMIN/NHÂN VIÊN ---
                            <div class="navbar-nav d-flex align-items-center" style="flex-direction: row; gap: 10px;">
                                <span style="color: #333; font-weight: 500;">Chào, @Session["TenNV"]</span>

                                <a href="@Url.Action("Index", "Admin")" class="btn btn-primary btn-sm">
                                    <i class="fas fa-tachometer-alt me-1"></i> Trang Quản Trị
                                </a>

                                <a href="@Url.Action("DangXuat", "TaiKhoan")" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
                            </div>
                        }
                    }
                    else
                    {
                        // --- TRƯỜNG HỢP CHƯA ĐĂNG NHẬP ---
                        <a href="@Url.Action("DangNhap","TaiKhoan")" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-user me-1"></i> Đăng nhập
                        </a>
                    }

                    <a href="@Url.Action("XemGioHang", "GioHang")" class="btn btn-link text-dark position-relative">
                        <i class="fas fa-shopping-cart fa-lg"></i>
                        @{ Html.RenderAction("_GioHangPartial", "GioHang"); }
                    </a>
                    <button class="btn btn-link text-dark d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                        <i class="fas fa-bars fa-lg"></i>
                    </button>
                </div>
            </div>

            

            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
                <div class="container">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main_nav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-center" id="main_nav">
                        <ul class="navbar-nav">
                            @Html.Action("_NavBar", "NavBar")
                        </ul>
                    </div>
                </div>
            </nav>


        </div>
    </header>

    <main class="container">
        <div class="row">
            <div class="col-md-3">
                @Html.Action("_DanhMuc", "DanhMuc")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="newsletter-section">
            
            <div class="container">
                <div class="text-center">
                    <h3 class="newsletter-title">Đăng ký nhận tin</h3>
                    <p class="text-secondary mb-4">Nhận thông tin về sản phẩm mới và ưu đãi đặc biệt</p>
                    <form class="newsletter-form">
                        
                        <input type="email" class="newsletter-input" placeholder="Nhập email của bạn" />
                        <button type="submit" class="newsletter-btn">Đăng ký</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-main">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-3">
                        
                        <div class="footer-logo">
                            <div class="logo-icon">🌸</div>
                            <span class="footer-logo-text">FlowerShop</span> 
                        </div>
                        <p class="small mb-3">
                            
                            Cửa hàng hoa tươi uy tín, chất lượng hàng đầu Việt Nam.
                            Giao hàng nhanh chóng, thiết kế độc đáo. 
                        </p>
                        <div class="social-links">
                            
                            <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-twitter"></i></a> 
                        </div>
                    </div>
                    <div class="col-md-3">
                       
                        <h4 class="footer-heading">Về chúng tôi</h4>
                        <ul class="footer-links">
                            <li><a href="#">Giới thiệu</a></li>
                            <li><a href="#">Tin tức</a></li>
                            <li><a href="#">Tuyển dụng</a></li>
                            <li><a href="#">Chính sách đổi trả</a></li>
                            <li><a href="#">Bảo mật thông tin</a></li> 
                        </ul>
                    </div>
                    <div class="col-md-3">
                        
                        <h4 class="footer-heading">Hỗ trợ khách hàng</h4>
                        <ul class="footer-links">
                            <li><a href="#">Hướng dẫn đặt hàng</a></li>
                            <li><a href="#">Phương thức thanh toán</a></li> 
                            <li><a href="#">Chính sách giao hàng</a></li>
                            <li><a href="#">Câu hỏi thường gặp</a></li>
                            <li><a href="#">Liên hệ</a></li> 
                        </ul>
                    </div>
                    <div class="col-md-3">
                        
                        <h4 class="footer-heading">Thông tin liên hệ</h4>
                        <ul class="footer-links">
                            <li class="d-flex gap-2">
                                <i class="fas fa-map-marker-alt text-pink mt-1"></i>
                                <span>123 Đường Hoa, Quận 1, TP. Hồ Chí Minh</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fas fa-phone text-pink"></i>
                                <span>1900-1234</span> 
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fas fa-envelope text-pink"></i>
                                <span>info@flowershop.vn</span>
                            </li>
                        </ul> 
                        <div class="mt-3">
                            <p class="small mb-1">Giờ làm việc:</p>
                            <p class="small text-secondary">Thứ 2 - Chủ nhật: 8:00 - 22:00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            
            <div class="container">
                <div class="footer-bottom-content">
                    <p class="mb-0">© 2025 FlowerShop. Tất cả quyền được bảo lưu.</p> 
                    <div class="footer-bottom-links">
                        <a href="#">Điều khoản sử dụng</a>
                        <a href="#">Chính sách bảo mật</a>
                    </div> 
                </div>
            </div>
        </div>
    </footer>

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>

    <style>
        .text-pink {
            color: #ec4899;
            
        }
    </style>

    @RenderSection("Scripts", required: false)
</body>
</html>

<style>
    /* --- 1. STYLE CHUNG CHO CÁC Ô NHẬP LIỆU (GLASS STYLE) --- */
    .form-control,
    .form-select {
        background-color: rgba(255, 255, 255, 0.6) !important; /* Nền trắng trong suốt */
        backdrop-filter: blur(10px); /* Làm mờ nền đằng sau */
        border: 2px solid rgba(255, 255, 255, 0.8) !important; /* Viền trắng mờ sang trọng */
        border-radius: 25px !important; /* Bo tròn mềm mại */
        color: #555;
        box-shadow: inset 0 2px 4px rgba(236, 72, 153, 0.05); /* Bóng đổ nhẹ vào trong */
        transition: all 0.3s ease;
        padding-left: 15px;
    }

        /* Hiệu ứng khi click chuột vào (Focus) */
        .form-control:focus,
        .form-select:focus {
            background-color: rgba(255, 255, 255, 0.95) !important;
            border-color: #ec4899 !important; /* Viền chuyển màu hồng */
            box-shadow: 0 0 0 4px rgba(236, 72, 153, 0.15) !important; /* Glow hồng toả ra */
            color: #333;
        }

    /* --- 2. TÙY CHỈNH RIÊNG CHO THANH TÌM KIẾM (Ở HEADER) --- */
    .search-box .form-control {
        border-radius: 50px 0 0 50px !important; /* Bo tròn đầu trái */
        border-right: none !important; /* Bỏ viền phải để nối với nút tìm kiếm */
    }

    .search-box .btn {
        border-radius: 0 50px 50px 0 !important; /* Bo tròn đầu phải */
        border: 2px solid rgba(255, 255, 255, 0.8);
        border-left: none !important;
        background-color: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(10px);
        color: #ec4899;
        transition: all 0.3s;
        padding-right: 20px;
    }

        /* Hover vào nút tìm kiếm */
        .search-box .btn:hover {
            background-color: #ec4899;
            color: white;
            border-color: #ec4899;
        }

    /* --- 3. TÙY CHỈNH CHO NÚT ĐĂNG NHẬP / GIỎ HÀNG (BUTTONS) --- */
    .btn-outline-primary,
    .btn-outline-danger {
        border-radius: 50px; /* Bo tròn viên thuốc */
        border-width: 2px;
        backdrop-filter: blur(5px);
        background: rgba(255,255,255,0.5);
    }

        .btn-outline-primary:hover {
            background-color: #ec4899;
            border-color: #ec4899;
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.3);
        }

    /* --- 4. STYLE CHO HEADER NỔI BẬT --- */
    .main-header {
        position: relative;
        z-index: 100;
        padding-bottom: 10px;
    }
</style>