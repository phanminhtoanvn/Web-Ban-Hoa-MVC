<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Trang Quản Trị</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/fontawesome-free-7.1.0-web/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link href="~/Content/Admin.css" rel="stylesheet" />

    <style>
        
        body {
            background-color: #f3f4f6; /* Nền xám nhẹ làm nổi bật kính */
            font-family: 'Inter', sans-serif;
        }

        /* 1. Sidebar Kính Tối (Dark Glass) */
        .admin-sidebar {
            background: rgba(30, 41, 59, 0.95) !important; /* Màu xanh đen đậm */
            backdrop-filter: blur(15px);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            box-shadow: 5px 0 25px rgba(0,0,0,0.1);
        }

            .admin-sidebar .nav-link {
                color: rgba(255,255,255,0.7) !important;
                transition: all 0.3s;
                border-radius: 12px;
                margin: 5px 10px;
            }

                .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
                    background: rgba(236, 72, 153, 0.2) !important; /* Hồng admin */
                    color: #ec4899 !important;
                    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                }

        /* 2. Header Kính (Top Bar) */
        .admin-header {
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid white;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            margin-bottom: 30px;
            border-radius: 0 0 20px 20px; /* Bo tròn 2 góc dưới */
            padding: 15px 30px;
        }

        /* 3. Container chứa bảng dữ liệu (Glass Card Wrapper) */
        .admin-glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        }

        /* 4. Table đẹp hơn */
        .table-hover tbody tr:hover {
            background-color: rgba(236, 72, 153, 0.05); /* Hover hồng nhạt */
            transition: background-color 0.3s;
        }

        .admin-table-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        /* 5. Modal Kính */
        .modal-content {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(25px);
            border: 1px solid white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
    </style>

</head>



<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <div class="logo-icon">🌸</div>
                <span class="logo-text">Admin</span>
            </div>

            <nav class="admin-sidebar-nav">
                @{
                    int vaiTro = (Session["VaiTro"] != null) ? (int)Session["VaiTro"] : 0;
                    string currentAction = ViewContext.RouteData.Values["action"].ToString();
                }

                <a href="@Url.Action("Index", "Admin")"
                   class="nav-link @(currentAction == "Index" ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Tổng quan</span>
                </a>

                <a href="@Url.Action("DonHang", "Admin")"
                   class="nav-link @(currentAction == "DonHang" ? "active" : "")">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <span>Quản lý Đơn hàng</span>
                </a>

                @if (vaiTro == 1) // 1 = Admin
                {
                    <a href="@Url.Action("KhachHang", "Admin")"
                       class="nav-link @(currentAction == "KhachHang" ? "active" : "")">
                        <i class="fas fa-users-cog"></i>
                        <span>Danh sách Khách hàng</span>
                    </a>

                    <a href="@Url.Action("SanPham", "Admin")"
                       class="nav-link @(currentAction == "SanPham" ? "active" : "")">
                        <i class="fas fa-boxes"></i>
                        <span>Quản lý Sản phẩm</span>
                    </a>

                    <a href="@Url.Action("DanhMuc", "Admin")"
                       class="nav-link @(currentAction == "DanhMuc" ? "active" : "")">
                        <i class="fas fa-sitemap"></i>
                        <span>Quản lý Danh mục</span>
                    </a>

                    <a href="@Url.Action("LoaiHoa", "Admin")"
                       class="nav-link @(currentAction == "LoaiHoa" ? "active" : "")">
                        <i class="fas fa-seedling"></i> <span>Quản lý Loại hoa</span>
                    </a>
                    <a class="nav-link" href="@Url.Action("Clickstream", "Admin")">
                        <i class="fas fa-chart-line me-2"></i>
                        <span>Thống kê Clickstream</span>
                    </a>
                }
            </nav>
            <div class="admin-sidebar-footer">
                <a href="@Url.Action("Index", "Hoa")" class="nav-link" target="_blank">
                    <i class="fas fa-store"></i>
                    <span>Quay về Shop</span>
                </a>
                <a href="@Url.Action("DangXuat", "TaiKhoan")" class="nav-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                <span class="fw-semibold">
                    Chào, @(Session["TenNV"] ?? "Admin")
                </span>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>